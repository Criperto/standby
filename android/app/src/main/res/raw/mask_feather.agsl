// Port faithful de CripertoShell mask_feather.frag hacia Android AGSL (SkSL, API 33+)
uniform shader maskSrc;
uniform shader wallpaperSrc;
uniform float2 itemSize;
uniform float featherPx; // 0 = contorno original, >0 = expansión gradual hacia afuera
uniform float mode;      // 0.0 = stencil blanco alpha, 1.0 = cutout RGB de wallpaperSrc
uniform float opacity;

float evalFeatheredAlpha(float2 fragCoord) {
    float2 safeCoord = clamp(fragCoord, float2(0.5), max(itemSize - float2(0.5), float2(1.0)));
    float a0 = clamp(float(maskSrc.eval(safeCoord).a), 0.0, 1.0);
    if (featherPx <= 0.5) {
        return a0;
    }
    if (a0 >= 0.99) {
        return 1.0;
    }

    float maxAlpha = a0;
    float jit = fract(52.9829189 * fract(dot(fragCoord, float2(0.06711056, 0.00583715)))) - 0.5;

    for (int ri = 1; ri <= 7; ++ri) {
        float rNorm = clamp((float(ri) - 0.5 + jit * 0.85) / 7.0, 0.02, 1.0);
        float rPx = rNorm * featherPx;
        float falloff = 1.0 - smoothstep(0.0, 1.0, rNorm);
        float angOffset = float(ri) * 0.39269908;
        for (int di = 0; di < 8; ++di) {
            float ang = float(di) * 0.78539816 + angOffset;
            float2 sc = clamp(fragCoord + float2(cos(ang), sin(ang)) * rPx, float2(0.5), max(itemSize - float2(0.5), float2(1.0)));
            float sA = clamp(float(maskSrc.eval(sc).a), 0.0, 1.0);
            maxAlpha = max(maxAlpha, sA * falloff);
        }
    }
    return clamp(maxAlpha, 0.0, 1.0);
}

half4 main(float2 fragCoord) {
    float outAlpha = evalFeatheredAlpha(fragCoord);
    if (mode > 0.5) {
        float3 wpRgb = float3(wallpaperSrc.eval(fragCoord).rgb);
        return half4(half3(wpRgb * outAlpha * opacity), half(outAlpha * opacity));
    }
    return half4(half(outAlpha * opacity));
}
