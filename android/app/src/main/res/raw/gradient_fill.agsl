// Port faithful de CripertoShell gradient_fill.frag hacia Android AGSL (SkSL, API 33+)
uniform shader src;
uniform float useSourceAlpha;
uniform float gradType;   // 0 = linear, 1 = radial, 2 = angular, 3 = diamond
uniform float stopCount;  // 2..8
uniform float2 itemSize;
uniform float2 p0;
uniform float2 p1;
uniform float2 p2;
uniform float4 pos03;
uniform float4 pos47;
uniform float4 c0;
uniform float4 c1;
uniform float4 c2;
uniform float4 c3;
uniform float4 c4;
uniform float4 c5;
uniform float4 c6;
uniform float4 c7;
uniform float opacity;

float evalGradT(float2 uv) {
    float2 d1 = p1 - p0;
    float2 d2 = p2 - p0;
    float det = d1.x * d2.y - d2.x * d1.y;
    float2 rel = uv - p0;
    float2 localUV;
    if (abs(det) < 1e-6) {
        float denom = max(dot(d1, d1), 1e-6);
        localUV = float2(dot(rel, d1) / denom, 0.0);
    } else {
        float invDet = 1.0 / det;
        localUV = float2(
            (d2.y * rel.x - d2.x * rel.y) * invDet,
            (-d1.y * rel.x + d1.x * rel.y) * invDet
        );
    }

    if (gradType < 0.5) {
        return clamp(localUV.x, 0.0, 1.0);
    } else if (gradType < 1.5) {
        return clamp(length(localUV), 0.0, 1.0);
    } else if (gradType < 2.5) {
        if (length(localUV) < 1e-6) return 0.0;
        float ang = atan(localUV.y, localUV.x);
        return fract(ang / 6.28318530718);
    }
    return clamp(abs(localUV.x) + abs(localUV.y), 0.0, 1.0);
}

float4 toPremul(float4 c) {
    return float4(c.rgb * c.a, c.a);
}

float4 evalStopsPremul(float t) {
    int count = clamp(int(stopCount + 0.5), 2, 8);
    float pArr[8];
    pArr[0] = pos03.x; pArr[1] = pos03.y; pArr[2] = pos03.z; pArr[3] = pos03.w;
    pArr[4] = pos47.x; pArr[5] = pos47.y; pArr[6] = pos47.z; pArr[7] = pos47.w;

    float4 cArr[8];
    cArr[0] = toPremul(c0); cArr[1] = toPremul(c1); cArr[2] = toPremul(c2); cArr[3] = toPremul(c3);
    cArr[4] = toPremul(c4); cArr[5] = toPremul(c5); cArr[6] = toPremul(c6); cArr[7] = toPremul(c7);

    float4 res = cArr[0];
    for (int i = 0; i < 7; ++i) {
        if (i >= count - 1) break;
        float pa = pArr[i];
        float pb = pArr[i + 1];
        if (t >= pa) {
            float span = pb - pa;
            float f = (span <= 1e-6) ? 1.0 : clamp((t - pa) / span, 0.0, 1.0);
            res = mix(cArr[i], cArr[i + 1], f);
        }
    }
    return clamp(res, 0.0, 1.0);
}

half4 main(float2 fragCoord) {
    float srcA = (useSourceAlpha > 0.5) ? float(src.eval(fragCoord).a) : 1.0;
    if (srcA <= 0.0005) {
        return half4(0.0);
    }
    float2 uv = fragCoord / max(itemSize, float2(1.0));
    float t = evalGradT(uv);
    float4 colPremul = evalStopsPremul(t);
    return half4(colPremul * srcA * opacity);
}
